# --- Star gate (GitHub OAuth App: github.com/settings/developers → New OAuth App) ---
# Callback URL: https://<your-domain>/api/auth/callback   (and http://localhost:3000/api/auth/callback for dev)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32+ random chars: `openssl rand -base64 48`
SESSION_SECRET=

# The PUBLIC repo visitors must star.
NEXT_PUBLIC_STAR_REPO=Meet-1010/kinetiq
NEXT_PUBLIC_SITE_URL=https://kinetiq.vercel.app

# Optional: any token, only used to raise the rate limit for the star counter in the header.
GITHUB_PUBLIC_TOKEN=

# --- Code vault (production) ---
# Zips live as assets on a release of a PRIVATE repo. Upload with: npm run vault:upload
# Token: fine-grained PAT with read access to "Contents" on that repo only.
VAULT_REPO=Meet-1010/kinetiq-vault
VAULT_TOKEN=
VAULT_TAG=vault
