// Live-demo host: a Worker serving demos/ as static assets on its own origin.
// Deploy with `npm run demos:deploy` (build first with `npm run demos:build`).
{
  "name": "kinetiq-demos",
  "main": "../../scripts/demo-worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "../../demos",
    "binding": "ASSETS",
    // The worker sees every request first: security headers, SPA fallback, root-path redirects.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    // Sites allowed to embed the demos in an iframe.
    "FRAME_ANCESTORS": "'self' http://localhost:3000 https://kinetiq.vercel.app"
  }
}
